{
  "version": 2,
  "routes": [
    {
      "src": "/api/download",
      "methods": ["GET", "OPTIONS"],
      "dest": "/api/download.js"
    },
    {
      "src": "/css/style.css",
      "dest": "/css/style.css"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
